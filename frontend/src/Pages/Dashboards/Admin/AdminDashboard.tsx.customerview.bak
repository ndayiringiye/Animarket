// --- Farmer/Customer type + API fetch ---

interface Farmer {
  _id: string;
  name?: string;
  email?: string;
  phone?: string;
  role?: string;
  status?: string;
  createdAt?: string;
}

// --- Hotel type (separate collection, fetched from /api/hotels/all) ---

interface Hotel {
  _id: string;
  hotelName?: string;
  email?: string;
  phone?: string;
  city?: string;
  country?: string;
  hotelType?: string;
  isVerified?: boolean;
  status?: string;
}

// --- Sub Components ---

const SidebarItem = ({
  icon: Icon,
  label,
  active = false,
  badge,
  hasSubmenu = false,
  collapsed = false,
  onClick
}: {
  icon: any;
  label: string;
  active?: boolean;
  badge?: string;
  hasSubmenu?: boolean;
  collapsed?: boolean;
  onClick?: () => void;
}) => (
  <div
    onClick={onClick}
    className={`group flex items-center justify-between px-3 py-2.5 mx-2 rounded-lg cursor-pointer transition-all duration-200 ${
    active
      ? 'bg-white/15 text-white shadow-sm'
      : 'text-emerald-50/80 hover:text-white hover:bg-white/10'
  }`}>
    <div className="flex items-center gap-3 min-w-0">
      <Icon size={18} className="shrink-0" />
      {!collapsed && <span className="text-[13px] font-medium truncate">{label}</span>}
    </div>
    {!collapsed && (
      <div className="flex items-center gap-1.5 shrink-0">
        {badge && (
          <span className="bg-white/20 text-white text-[10px] px-2 py-0.5 rounded-full font-semibold">
            {badge}
          </span>
        )}
        {hasSubmenu && <ChevronRight size={14} className="opacity-60 group-hover:opacity-100 transition-opacity" />}
      </div>
    )}
  </div>
);

const SidebarSection = ({ title, collapsed }: { title: string; collapsed?: boolean }) => (
  <div className={`px-5 mt-6 mb-2 ${collapsed ? 'text-center' : ''}`}>
    {!collapsed && (
      <span className="text-[10px] font-semibold text-emerald-200/60 uppercase tracking-wider">
        {title}
      </span>
    )}
    {collapsed && <div className="h-px bg-white/10 mx-2" />}
  </div>
);

const StatCard = ({
  title,
  value,
  change,
  isPositive,
  icon: Icon,
  subtitle
}: {
  title: string;
  value: string;
  change: string;
  isPositive: boolean;
  icon: any;
  subtitle?: string;
}) => (
  <div className="group bg-white rounded-xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
    <div className="flex justify-between items-start mb-4">
      <div className="p-2.5 rounded-lg bg-emerald-50 text-emerald-600 group-hover:bg-emerald-100 transition-colors">
        <Icon size={20} />
      </div>
      <div className={`flex items-center gap-1 text-xs font-semibold px-2 py-1 rounded-full ${
        isPositive ? 'text-emerald-700 bg-emerald-50' : 'text-red-600 bg-red-50'
      }`}>
        {isPositive ? <ArrowUpRight size={14} /> : <ArrowDownRight size={14} />}
        {change}
      </div>
    </div>
    <div>
      <p className="text-slate-500 text-xs font-medium mb-1">{title}</p>
      <h3 className="text-2xl font-bold text-slate-800 mb-1">{value}</h3>
      {subtitle && <p className="text-[11px] text-slate-400">{subtitle}</p>}
    </div>
  </div>
);

const ChartCard = ({ title, children, action, subtitle }: { title: string; children: React.ReactNode; action?: React.ReactNode; subtitle?: string }) => (
  <div className="bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
    <div className="flex justify-between items-center px-5 py-4 border-b border-slate-50">
      <div>
        <h3 className="text-sm font-semibold text-slate-800">{title}</h3>
        {subtitle && <p className="text-[11px] text-slate-400 mt-0.5">{subtitle}</p>}
      </div>
      {action}
    </div>
    <div className="p-5">{children}</div>
  </div>
);

const Badge = ({ children, variant = 'default' }: { children: React.ReactNode; variant?: 'default' | 'success' | 'warning' | 'danger' }) => {
  const variants = {
    default: 'bg-slate-100 text-slate-600',
    success: 'bg-emerald-50 text-emerald-700',
    warning: 'bg-amber-50 text-amber-700',
    danger: 'bg-red-50 text-red-600',
  };
  return (
    <span className={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${variants[variant]}`}>
      {children}
    </span>
  );
};

// --- Shared Manage Farmers / Manage Customers table view ---
// Same table UI, same API endpoint (/api/users), just fed different
// pre-filtered arrays (farmers vs customers) from the parent component.

const FarmersView = ({
  farmers,
  loading,
  error,
  onRetry,
  onDelete,
  onUpdateRole,
  onView,
  title = 'Manage Farmers',
  subtitle = 'All registered farmers on the platform'
}: {
  farmers: Farmer[];
  loading: boolean;
  error: string | null;
  onRetry: () => void;
  onDelete?: (id: string) => void;
  onUpdateRole?: (id: string, role: string) => void;
  onView?: (id: string) => void;
  title?: string;
  subtitle?: string;
}) => (
  <div className="bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
    <div className="px-5 py-4 border-b border-slate-50 flex justify-between items-center">
      <div>
        <h3 className="text-sm font-semibold text-slate-800">{title}</h3>
        <p className="text-[11px] text-slate-400 mt-0.5">{subtitle}</p>
      </div>
      <button
        onClick={onRetry}
        className="flex items-center gap-1.5 text-[11px] font-medium text-slate-500 border border-slate-200 px-2.5 py-1.5 rounded-lg hover:bg-slate-50 transition-colors"
      >
        <RefreshCw size={12} /> Refresh
      </button>
    </div>

    {loading && (
      <div className="p-8 text-center text-sm text-slate-400">Loading...</div>
    )}

    {!loading && error && (
      <div className="p-8 text-center text-sm text-red-500">{error}</div>
    )}

    {!loading && !error && farmers.length === 0 && (
      <div className="p-8 text-center text-sm text-slate-400">No records found.</div>
    )}

    {!loading && !error && farmers.length > 0 && (
      <div className="overflow-x-auto">
        <table className="w-full text-left text-sm whitespace-nowrap">
          <thead className="bg-slate-50 text-slate-500 text-[10px] uppercase font-semibold">
            <tr>
              <th className="px-5 py-3">Name</th>
              <th className="px-5 py-3">Email</th>
              <th className="px-5 py-3">Phone</th>
              <th className="px-5 py-3">Status</th>
              <th className="px-5 py-3">Role</th>
              <th className="px-5 py-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-50">
            {farmers.map((farmer) => (
              <tr key={farmer._id} className="hover:bg-slate-50/50 transition-colors">
                <td className="px-5 py-3.5">
                  <div className="flex items-center gap-3">
                    <div className="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-600 shrink-0">
                      <UserCheck size={16} />
                    </div>
                    <div className="font-medium text-slate-700 text-xs">{farmer.name || 'Unnamed'}</div>
                  </div>
                </td>
                <td className="px-5 py-3.5 text-slate-500 text-xs">{farmer.email || '-'}</td>
                <td className="px-5 py-3.5 text-slate-500 text-xs">{farmer.phone || '-'}</td>
                <td className="px-5 py-3.5">
                  <Badge variant={farmer.status === 'active' ? 'success' : 'warning'}>
                    {farmer.status || 'unknown'}
                  </Badge>
                </td>
                <td className="px-5 py-3.5">
                  {onUpdateRole ? (
                    <select
                      value={farmer.role || ''}
                      onChange={(e) => onUpdateRole(farmer._id, e.target.value)}
                      className="text-[11px] border border-slate-200 rounded-lg px-2 py-1.5 text-slate-600 bg-white focus:border-emerald-500 outline-none"
                    >
                      <option value="farmer">Farmer</option>
                      <option value="customer">Customer</option>
                      <option value="vet">Vet</option>
                      <option value="hotel">Hotel</option>
                      <option value="admin">Admin</option>
                    </select>
                  ) : (
                    <span className="text-[11px] text-slate-500">{farmer.role || '-'}</span>
                  )}
                </td>
                <td className="px-5 py-3.5 text-right">
                  <div className="flex items-center justify-end gap-2">
                    <button onClick={() => onView && onView(farmer._id)} className="text-[11px] font-medium bg-emerald-600 text-white px-3 py-1.5 rounded-lg hover:bg-emerald-700 transition-colors shadow-sm">
                      View
                    </button>
                    {onDelete && (
                      <button
                        onClick={() => onDelete(farmer._id)}
                        className="text-[11px] font-medium bg-red-50 text-red-600 px-3 py-1.5 rounded-lg hover:bg-red-100 transition-colors"
                      >
                        Delete
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
);

// --- Manage Hotels view ---
// Separate from FarmersView because hotels have a different shape
// (hotelName, city, hotelType, isVerified) and come from a different endpoint.

const HotelsView = ({
  hotels,
  loading,
  error,
  onRetry,
  onApprove,
  onView,
}: {
  hotels: Hotel[];
  loading: boolean;
  error: string | null;
  onRetry: () => void;
  onApprove?: (id: string, approvalStatus: 'approved' | 'rejected') => void;
  onView?: (id: string) => void;
}) => (
  <div className="bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
    <div className="px-5 py-4 border-b border-slate-50 flex justify-between items-center">
      <div>
        <h3 className="text-sm font-semibold text-slate-800">Manage Hotels</h3>
        <p className="text-[11px] text-slate-400 mt-0.5">All registered hotels on the platform</p>
      </div>
      <button
        onClick={onRetry}
        className="flex items-center gap-1.5 text-[11px] font-medium text-slate-500 border border-slate-200 px-2.5 py-1.5 rounded-lg hover:bg-slate-50 transition-colors"
      >
        <RefreshCw size={12} /> Refresh
      </button>
    </div>

    {loading && (
      <div className="p-8 text-center text-sm text-slate-400">Loading...</div>
    )}

    {!loading && error && (
      <div className="p-8 text-center text-sm text-red-500">{error}</div>
    )}

    {!loading && !error && hotels.length === 0 && (
      <div className="p-8 text-center text-sm text-slate-400">No records found.</div>
    )}

    {!loading && !error && hotels.length > 0 && (
      <div className="overflow-x-auto">
        <table className="w-full text-left text-sm whitespace-nowrap">
          <thead className="bg-slate-50 text-slate-500 text-[10px] uppercase font-semibold">
            <tr>
              <th className="px-5 py-3">Hotel Name</th>
              <th className="px-5 py-3">Email</th>
              <th className="px-5 py-3">Phone</th>
              <th className="px-5 py-3">City</th>
              <th className="px-5 py-3">Verified</th>
              <th className="px-5 py-3">Status</th>
              <th className="px-5 py-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-50">
            {hotels.map((hotel) => (
              <tr key={hotel._id} className="hover:bg-slate-50/50 transition-colors">
                <td className="px-5 py-3.5">
                  <div className="flex items-center gap-3">
                    <div className="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-600 shrink-0">
                      <Building2 size={16} />
                    </div>
                    <div className="font-medium text-slate-700 text-xs">{hotel.hotelName || 'Unnamed'}</div>
                  </div>
                </td>
                <td className="px-5 py-3.5 text-slate-500 text-xs">{hotel.email || '-'}</td>
                <td className="px-5 py-3.5 text-slate-500 text-xs">{hotel.phone || '-'}</td>
                <td className="px-5 py-3.5 text-slate-500 text-xs">{hotel.city || '-'}</td>
                <td className="px-5 py-3.5">
                  <Badge variant={hotel.isVerified ? 'success' : 'warning'}>
                    {hotel.isVerified ? 'verified' : 'unverified'}
                  </Badge>
                </td>
                <td className="px-5 py-3.5">
                  <Badge variant={hotel.status === 'active' ? 'success' : 'warning'}>
                    {hotel.status || 'unknown'}
                  </Badge>
                </td>
                <td className="px-5 py-3.5 text-right">
                  <div className="flex items-center justify-end gap-2">
                    <button
                      onClick={() => onView && onView(hotel._id)}
                      className="text-[11px] font-medium bg-emerald-600 text-white px-3 py-1.5 rounded-lg hover:bg-emerald-700 transition-colors shadow-sm"
                    >
                      View
                    </button>
                    {onApprove && hotel.status !== 'active' && (
                      <button
                        onClick={() => onApprove(hotel._id, 'approved')}
                        className="text-[11px] font-medium bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-lg hover:bg-emerald-100 transition-colors"
                      >
                        Approve
                      </button>
                    )}
                    {onApprove && hotel.status !== 'rejected' && (
                      <button
                        onClick={() => onApprove(hotel._id, 'rejected')}
                        className="text-[11px] font-medium bg-red-50 text-red-600 px-3 py-1.5 rounded-lg hover:bg-red-100 transition-colors"
                      >
                        Reject
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
);

// --- Hotel Detail Modal ---

const HotelDetailModal = ({
  hotel,
  loading,
  error,
  onClose,
}: {
  hotel: any | null;
  loading: boolean;
  error: string | null;
  onClose: () => void;
}) => (
  <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-[60] flex items-center justify-center p-4" onClick={onClose}>
    <div
      className="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden max-h-[90vh] flex flex-col"
      onClick={(e) => e.stopPropagation()}
    >
      {loading && (
        <div className="p-10 text-center text-sm text-slate-400">Loading hotel profile...</div>
      )}
      {!loading && error && (
        <div className="p-10 text-center">
          <p className="text-sm text-red-500 mb-3">{error}</p>
          <button onClick={onClose} className="text-xs font-medium text-slate-500 border border-slate-200 px-3 py-1.5 rounded-lg hover:bg-slate-50">
            Close
          </button>
        </div>
      )}
      {!loading && !error && hotel && (
        <>
          {/* Cover */}
          <div className="relative h-32 bg-gradient-to-br from-emerald-500 to-emerald-700 shrink-0">
            {hotel.coverImage && (
              <img
                src={hotel.coverImage}
                alt="Cover"
                className="w-full h-full object-cover"
              />
            )}
            <button
              onClick={onClose}
              className="absolute top-3 right-3 p-1.5 rounded-lg bg-black/30 hover:bg-black/50 text-white transition-colors"
            >
              <X size={16} />
            </button>
            <div className="absolute -bottom-9 left-5">
              <div className="w-[72px] h-[72px] rounded-2xl bg-white p-1 shadow-lg">
                {hotel.profileImage ? (
                  <img
                    src={hotel.profileImage}
                    alt={hotel.hotelName}
                    className="w-full h-full object-cover rounded-xl"
                  />
                ) : (
                  <div className="w-full h-full rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600">
                    <Building2 size={28} />
                  </div>
                )}
              </div>
            </div>
            {hotel.logo && (
              <div className="absolute -bottom-9 left-[86px] w-9 h-9 rounded-lg bg-white p-1 shadow-md">
                <img src={hotel.logo} alt="Logo" className="w-full h-full object-cover rounded-md" />
              </div>
            )}
          </div>

          {/* Header info */}
          <div className="px-5 pt-12 pb-4 border-b border-slate-100">
            <div className="flex items-start justify-between gap-3">
              <div className="min-w-0">
                <h3 className="text-base font-bold text-slate-800 truncate">{hotel.hotelName || 'Unnamed Hotel'}</h3>
                <p className="text-[11px] text-slate-400 mt-0.5">{hotel.email || '-'}</p>
              </div>
              <div className="flex flex-col items-end gap-1.5 shrink-0">
                <Badge variant={hotel.status === 'active' ? 'success' : hotel.status === 'rejected' ? 'danger' : 'warning'}>
                  {hotel.status || 'unknown'}
                </Badge>
                <Badge variant={hotel.isVerified ? 'success' : 'warning'}>
                  {hotel.isVerified ? 'verified' : 'unverified'}
                </Badge>
              </div>
            </div>
          </div>

          {/* Details grid */}
          <div className="p-5 overflow-y-auto">
            <div className="grid grid-cols-2 gap-x-4 gap-y-4 text-sm">
              <div>
                <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">Phone</p>
                <p className="text-slate-700 font-medium truncate">{hotel.phone || '-'}</p>
              </div>
              <div>
                <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">Type</p>
                <p className="text-slate-700 font-medium capitalize truncate">{hotel.hotelType || '-'}</p>
              </div>
              <div>
                <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">City</p>
                <p className="text-slate-700 font-medium truncate">{hotel.city || '-'}</p>
              </div>
              <div>
                <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">Country</p>
                <p className="text-slate-700 font-medium truncate">{hotel.country || '-'}</p>
              </div>
              <div className="col-span-2">
                <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">Address</p>
                <p className="text-slate-700 font-medium truncate">{hotel.address || '-'}</p>
              </div>
              <div>
                <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">Registration No.</p>
                <p className="text-slate-700 font-medium truncate">{hotel.registrationNumber || '-'}</p>
              </div>
              <div>
                <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">Account Type</p>
                <p className="text-slate-700 font-medium capitalize truncate">{(hotel.accountType || '-').toString().replace('_', ' ')}</p>
              </div>
              <div>
                <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">Contact Person</p>
                <p className="text-slate-700 font-medium truncate">{hotel.contactPersonName || '-'}</p>
              </div>
              <div>
                <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">Contact Phone</p>
                <p className="text-slate-700 font-medium truncate">{hotel.contactPersonPhone || '-'}</p>
              </div>
              {hotel.contactPersonEmail && (
                <div className="col-span-2">
                  <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">Contact Email</p>
                  <p className="text-slate-700 font-medium truncate">{hotel.contactPersonEmail}</p>
                </div>
              )}
              {hotel.website && (
                <div className="col-span-2">
                  <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">Website</p>
                  <a href={hotel.website} target="_blank" rel="noopener noreferrer" className="text-emerald-600 font-medium truncate hover:underline block">
                    {hotel.website}
                  </a>
                </div>
              )}
            </div>

            {/* Stats row */}
            <div className="grid grid-cols-3 gap-3 mt-5 pt-4 border-t border-slate-100">
              <div className="bg-slate-50 rounded-lg p-3 text-center">
                <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">Wallet</p>
                <p className="text-sm font-bold text-slate-800">${hotel.walletBalance ?? 0}</p>
              </div>
              <div className="bg-slate-50 rounded-lg p-3 text-center">
                <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">Rating</p>
                <p className="text-sm font-bold text-slate-800">{hotel.averageRating ?? 0}</p>
              </div>
              <div className="bg-slate-50 rounded-lg p-3 text-center">
                <p className="text-[10px] text-slate-400 uppercase font-semibold mb-1">Agreements</p>
                <p className="text-sm font-bold text-slate-800">{Array.isArray(hotel.agreements) ? hotel.agreements.length : 0}</p>
              </div>
            </div>
          </div>
        </>
      )}
    </div>
  </div>
);

// --- Main Layout ---

const AdminDashboard = () => {
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
  const [mobileSidebarOpen, setMobileSidebarOpen] = useState(false);
  const [activeView, setActiveView] = useState<'dashboard' | 'farmers' | 'customers' | 'hotels' | 'animals'>('dashboard');

  const [farmers, setFarmers] = useState<Farmer[]>([]);
  const [farmersLoading, setFarmersLoading] = useState(false);
  const [farmersError, setFarmersError] = useState<string | null>(null);

  const [customers, setCustomers] = useState<Farmer[]>([]);
  const [customersLoading, setCustomersLoading] = useState(false);
  const [customersError, setCustomersError] = useState<string | null>(null);

  const [hotels, setHotels] = useState<Hotel[]>([]);
  const [hotelsLoading, setHotelsLoading] = useState(false);
  const [hotelsError, setHotelsError] = useState<string | null>(null);

  const [selectedHotel, setSelectedHotel] = useState<any | null>(null);
  const [showHotelModal, setShowHotelModal] = useState(false);
  const [hotelDetailLoading, setHotelDetailLoading] = useState(false);
  const [hotelDetailError, setHotelDetailError] = useState<string | null>(null);

  const [animals, setAnimals] = useState<any[]>([]);
  const [animalsLoading, setAnimalsLoading] = useState(false);
  const [animalsError, setAnimalsError] = useState<string | null>(null);

  // Both fetchers hit the SAME endpoint (/api/users) and only differ
  // in which role they keep after fetching � that's the integration point.
  const USERS_ENDPOINT = 'http://localhost:4000/api/users';
  // Hotels are a separate collection/model, so they get their own endpoint.
  const HOTELS_ENDPOINT = 'http://localhost:4000/api/hotels/all';
  const ANIMALS_ENDPOINT = 'http://localhost:4000/api/animal/admin/animals';
  const AGREEMENT_ENDPOINT = "http://localhost:4000/api/agreements/pdf-proxy";

  const [showFarmerModal, setShowFarmerModal] = useState(false);
  const [selectedFarmer, setSelectedFarmer] = useState<any>(null);
  const [farmerDetailLoading, setFarmerDetailLoading] = useState(false);
  const [farmerDetailError, setFarmerDetailError] = useState<string | null>(null);

  const viewFarmer = async (id: string) => {
    setShowFarmerModal(true);
    setFarmerDetailLoading(true);
    setFarmerDetailError(null);
    setSelectedFarmer(null);
    try {
      const token = localStorage.getItem('token');
      const res = await axios.get(`${USERS_ENDPOINT}/${id}`, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      setSelectedFarmer(res.data?.data || null);
    } catch (err: any) {
      setFarmerDetailError(err?.response?.data?.message || 'Failed to load farmer');
    } finally {
      setFarmerDetailLoading(false);
    }
  };

  const fetchFarmers = async () => {
    setFarmersLoading(true);
    setFarmersError(null);
    try {
      const token = localStorage.getItem('token');
      const res = await axios.get(USERS_ENDPOINT, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      const allUsers = Array.isArray(res.data)
        ? res.data
        : res.data.users || res.data.data || res.data.result || [];
      const farmerUsers = allUsers.filter((u: any) => u.role === 'farmer');
      setFarmers(farmerUsers);
    } catch (err: any) {
      setFarmersError(err?.response?.data?.message || 'Failed to load farmers');
    } finally {
      setFarmersLoading(false);
    }
  };

  const deleteFarmer = async (id: string) => {
    if (!window.confirm('Delete this farmer account? This cannot be undone.')) return;
    try {
      const token = localStorage.getItem('token');
      const res = await axios.delete(`${USERS_ENDPOINT}/${id}`, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      if (res.status === 200) {
        setFarmers((prev) => prev.filter((f) => f._id !== id));
      }
    } catch (err: any) {
      alert(err?.response?.data?.message || 'Failed to delete farmer');
    }
  };

  const updateFarmerRole = async (id: string, role: string) => {
    try {
      const token = localStorage.getItem('token');
      const res = await axios.put(`${USERS_ENDPOINT}/${id}/role`, { role }, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      if (res.status === 200) {
        setFarmers((prev) => prev.map((f) => (f._id === id ? { ...f, role } : f)));
      }
    } catch (err: any) {
      alert(err?.response?.data?.message || 'Failed to update role');
    }
  };

  const fetchCustomers = async () => {
    setCustomersLoading(true);
    setCustomersError(null);
    try {
      const token = localStorage.getItem('token');
      const res = await axios.get(USERS_ENDPOINT, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      const allUsers = Array.isArray(res.data)
        ? res.data
        : res.data.users || res.data.data || res.data.result || [];
      const customerUsers = allUsers.filter((u: any) => u.role === 'customer');
      setCustomers(customerUsers);
    } catch (err: any) {
      setCustomersError(err?.response?.data?.message || 'Failed to load customers');
    } finally {
      setCustomersLoading(false);
    }
  };

  const deleteCustomer = async (id: string) => {
    if (!window.confirm('Delete this customer account? This cannot be undone.')) return;
    try {
      const token = localStorage.getItem('token');
      const res = await axios.delete(`${USERS_ENDPOINT}/${id}`, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      if (res.status === 200) {
        setCustomers((prev) => prev.filter((c) => c._id !== id));
      }
    } catch (err: any) {
      alert(err?.response?.data?.message || 'Failed to delete customer');
    }
  };

  const updateCustomerRole = async (id: string, role: string) => {
    try {
      const token = localStorage.getItem('token');
      const res = await axios.put(`${USERS_ENDPOINT}/${id}/role`, { role }, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      if (res.status === 200) {
        setCustomers((prev) => prev.map((c) => (c._id === id ? { ...c, role } : c)));
      }
    } catch (err: any) {
      alert(err?.response?.data?.message || 'Failed to update role');
    }
  };

  const fetchHotels = async () => {
    setHotelsLoading(true);
    setHotelsError(null);
    try {
      const token = localStorage.getItem('token');
      const res = await axios.get(HOTELS_ENDPOINT, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      const allHotels = Array.isArray(res.data)
        ? res.data
        : res.data.hotels || res.data.data || [];
      setHotels(allHotels);
    } catch (err: any) {
      setHotelsError(err?.response?.data?.message || 'Failed to load hotels');
    } finally {
      setHotelsLoading(false);
    }
  };

  const fetchAnimals = async () => {
    setAnimalsLoading(true);
    setAnimalsError(null);
    try {
      const token = localStorage.getItem('token');
      const res = await axios.get(ANIMALS_ENDPOINT, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      const allAnimals = Array.isArray(res.data)
        ? res.data
        : res.data.animals || res.data.data || [];
      setAnimals(allAnimals);
    } catch (err: any) {
      setAnimalsError(err?.response?.data?.message || 'Failed to load animals');
    } finally {
      setAnimalsLoading(false);
    }
  };

  const approveHotel = async (id: string, approvalStatus: 'approved' | 'rejected') => {
    try {
      const token = localStorage.getItem('token');
      const res = await axios.put(`${HOTELS_ENDPOINT.replace('/all', '')}/${id}/approve`, { approvalStatus }, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      if (res.status === 200) {
        const newStatus = approvalStatus === 'approved' ? 'active' : 'rejected';
        setHotels((prev) => prev.map((h) => (h._id === id ? { ...h, status: newStatus } : h)));
      }
    } catch (err: any) {
      alert(err?.response?.data?.message || 'Failed to update hotel approval');
    }
  };

  const viewHotel = async (id: string) => {
    setShowHotelModal(true);
    setHotelDetailLoading(true);
    setHotelDetailError(null);
    setSelectedHotel(null);
    try {
      const token = localStorage.getItem('token');
      const res = await axios.get(`${HOTELS_ENDPOINT.replace('/all', '')}/${id}/profile`, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      setSelectedHotel(res.data?.data || null);
    } catch (err: any) {
      setHotelDetailError(err?.response?.data?.message || 'Failed to load hotel profile');
    } finally {
      setHotelDetailLoading(false);
    }
  };

  useEffect(() => {
    if (activeView === 'farmers') {
      fetchFarmers();
    } else if (activeView === 'customers') {
      fetchCustomers();
    } else if (activeView === 'hotels') {
      fetchHotels();
    } else if (activeView === 'animals') {
      fetchAnimals();
    }
  }, [activeView]);

  const fetchAgreementPdf = async (agreementId: string) => {
    try {
      const token = localStorage.getItem('token');
      const res = await axios.get(`${AGREEMENT_ENDPOINT}/${agreementId}`, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
        responseType: 'blob', // Important for PDF
      });
      // Create a blob URL and open in new tab
      const blob = new Blob([res.data], { type: 'application/pdf' });
      const url = window.URL.createObjectURL(blob);
      window.open(url, '_blank');
    } catch (err: any) {
      alert(err?.response?.data?.message || 'Failed to fetch agreement PDF');
    }
  };

  const fetchAllAgreements = async () => {
    try {
      const token = localStorage.getItem('token');
      const res = await axios.get(AGREEMENT_ENDPOINT, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      console.log('All agreements:', res.data);
      setActiveView('agreements');
    } catch (err: any) {
      alert(err?.response?.data?.message || 'Failed to fetch agreements');
    }
  };
  return (
    <div className="flex h-screen bg-slate-50 font-sans text-slate-800 overflow-hidden">

      {/* Mobile Sidebar Overlay */}
      {mobileSidebarOpen && (
        <div
          className="fixed inset-0 bg-black/40 z-40 lg:hidden"
          onClick={() => setMobileSidebarOpen(false)}
        />
      )}

      {/* Sidebar */}
      <aside className={`
        fixed lg:static inset-y-0 left-0 z-50
        ${sidebarCollapsed ? 'w-[72px]' : 'w-64'}
        bg-emerald-600 flex flex-col flex-shrink-0
        transition-all duration-300 ease-in-out
        ${mobileSidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'}
      `}>
        {/* Logo */}
        <div className={`h-16 flex items-center border-b border-white/10 ${sidebarCollapsed ? 'justify-center px-2' : 'px-5'}`}>
          <div className="flex items-center gap-2.5">
            <div className="w-9 h-9 rounded-lg bg-white/20 flex items-center justify-center text-white font-bold text-lg shrink-0">
              A
            </div>
            {!sidebarCollapsed && (
              <span className="text-white font-bold text-lg tracking-tight">AniMarket</span>
            )}
          </div>
        </div>

        {/* Sidebar Content */}
        <div className="flex-1 overflow-y-auto py-4 custom-scrollbar">
          <SidebarSection title="Main" collapsed={sidebarCollapsed} />
          <SidebarItem
            icon={LayoutDashboard}
            label="Dashboard"
            active={activeView === 'dashboard'}
            collapsed={sidebarCollapsed}
            onClick={() => setActiveView('dashboard')}
          />

          <SidebarSection title="User Management" collapsed={sidebarCollapsed} />
          <SidebarItem
            icon={Users}
            label="Manage Farmers"
            hasSubmenu
            collapsed={sidebarCollapsed}
            active={activeView === 'farmers'}
            onClick={() => setActiveView('farmers')}
          />
          <SidebarItem
            icon={Users}
            label="Manage Customers"
            hasSubmenu
            collapsed={sidebarCollapsed}
            active={activeView === 'customers'}
            onClick={() => setActiveView('customers')}
          />
          <SidebarItem
            icon={Building2}
            label="Manage Hotels"
            hasSubmenu
            collapsed={sidebarCollapsed}
            active={activeView === 'hotels'}
            onClick={() => setActiveView('hotels')}
          />
          <SidebarItem icon={Stethoscope} label="Manage Vets" hasSubmenu collapsed={sidebarCollapsed} />
          <SidebarItem icon={ShieldCheck} label="Roles & Permissions" collapsed={sidebarCollapsed} />

          <SidebarSection title="Livestock" collapsed={sidebarCollapsed} />
          <SidebarItem
            icon={Beef}
            label="All Livestock"
            hasSubmenu
            collapsed={sidebarCollapsed}
            active={activeView === 'animals'}
            onClick={() => setActiveView('animals')}
          />
          <SidebarItem icon={QrCode} label="Animal Passports" hasSubmenu collapsed={sidebarCollapsed} />
          <SidebarItem icon={FileText} label="Ownership Docs" badge="12" collapsed={sidebarCollapsed} />
          <SidebarItem icon={CheckCircle2} label="Pending Verifications" badge="8" collapsed={sidebarCollapsed} />

          <SidebarSection title="Transactions" collapsed={sidebarCollapsed} />
          <SidebarItem icon={DollarSign} label="All Transactions" collapsed={sidebarCollapsed} />
          <SidebarItem icon={Handshake} label="Agreements" collapsed={sidebarCollapsed} onClick={fetchAllAgreements} />
          <SidebarItem icon={AlertTriangle} label="Disputes" badge="3" collapsed={sidebarCollapsed} />

          <SidebarSection title="System" collapsed={sidebarCollapsed} />
          <SidebarItem icon={Stethoscope} label="Veterinary Records" collapsed={sidebarCollapsed} />
          <SidebarItem icon={MessageSquare} label="Communication" collapsed={sidebarCollapsed} />
          <SidebarItem icon={BarChart3} label="Reports & Analytics" collapsed={sidebarCollapsed} />
          <SidebarItem icon={Lock} label="Security & Logs" collapsed={sidebarCollapsed} />
          <SidebarItem icon={SlidersHorizontal} label="Platform Settings" collapsed={sidebarCollapsed} />
        </div>

        {/* Collapse Toggle (Desktop) */}
        <div className="hidden lg:flex items-center justify-center p-3 border-t border-white/10">
          <button
            onClick={() => setSidebarCollapsed(!sidebarCollapsed)}
            className="w-full flex items-center justify-center gap-2 py-2 rounded-lg text-emerald-50/70 hover:text-white hover:bg-white/10 transition-colors text-xs font-medium"
          >
            {sidebarCollapsed ? <ChevronRight size={16} /> : <ChevronLeft size={16} />}
            {!sidebarCollapsed && <span>Collapse</span>}
          </button>
        </div>
      </aside>

      {/* Main Content */}
      <main className="flex-1 flex flex-col min-w-0 overflow-hidden">

        {/* Header */}
        <header className="h-16 bg-white border-b border-slate-100 flex items-center justify-between px-4 lg:px-6 flex-shrink-0 z-30">
          <div className="flex items-center gap-3">
            <button
              className="lg:hidden p-2 rounded-lg hover:bg-slate-100 text-slate-500"
              onClick={() => setMobileSidebarOpen(true)}
            >
              <Menu size={20} />
            </button>
            <div>
              <h1 className="text-base font-bold text-slate-800">
                {activeView === 'farmers'
                  ? 'Manage Farmers'
                  : activeView === 'customers'
                  ? 'Manage Customers'
                  : activeView === 'hotels'
                  ? 'Manage Hotels'
                  : activeView === 'animals'
                  ? 'All Livestock'
                  : 'Admin Overview'}
              </h1>
              <p className="text-[11px] text-slate-400 hidden sm:block">
                {activeView === 'farmers'
                  ? 'View and manage registered farmers'
                  : activeView === 'customers'
                  ? 'View and manage registered customers'
                  : activeView === 'hotels'
                  ? 'View and manage registered hotels'
                  : activeView === 'animals'
                  ? 'View and manage all registered livestock'
                  : "Welcome back, here's what's happening"}
              </p>
            </div>
          </div>

          <div className="flex items-center gap-3 lg:gap-4">
            {/* Search */}
            <div className="relative hidden md:block">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" size={16} />
              <input
                type="text"
                placeholder="Search..."
                className="pl-9 pr-4 py-2 bg-slate-50 rounded-lg text-sm border border-slate-200 focus:border-emerald-500 focus:bg-white focus:ring-2 focus:ring-emerald-500/20 outline-none w-56 lg:w-72 text-slate-700 placeholder-slate-400 transition-all"
              />
            </div>

            {/* Actions */}
            <div className="flex items-center gap-1.5 lg:gap-2">
              <button className="p-2 rounded-lg hover:bg-slate-100 text-slate-500 transition-colors relative">
                <Bell size={18} />
                <span className="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full ring-2 ring-white"></span>
              </button>
              <button className="p-2 rounded-lg hover:bg-slate-100 text-slate-500 transition-colors hidden sm:block">
                <Moon size={18} />
              </button>
              <button className="p-2 rounded-lg hover:bg-slate-100 text-slate-500 transition-colors hidden sm:block">
                <Settings size={18} />
              </button>

              {/* Divider */}
              <div className="w-px h-8 bg-slate-200 mx-1 hidden sm:block" />

              {/* Profile */}
              <button className="flex items-center gap-2.5 pl-1 pr-2 py-1 rounded-lg hover:bg-slate-100 transition-colors">
                <div className="w-8 h-8 rounded-lg bg-emerald-600 flex items-center justify-center text-white text-xs font-bold">
                  AD
                </div>
                <div className="hidden lg:block text-left">
                  <p className="text-xs font-semibold text-slate-700 leading-none">Admin User</p>
                  <p className="text-[10px] text-slate-400 mt-0.5">Super Admin</p>
                </div>
                <ChevronDown size={14} className="text-slate-400 hidden lg:block" />
              </button>
            </div>
          </div>
        </header>

        {/* Dashboard Content */}
        <div className="flex-1 overflow-y-auto p-4 lg:p-6 bg-slate-50">

          {/* FARMER_MODAL_V2 */}
          {showFarmerModal && (
            <div
              className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4"
              onClick={() => setShowFarmerModal(false)}
            >
              <div
                className="relative bg-white w-full max-w-2xl max-h-[90vh] rounded-2xl shadow-2xl overflow-hidden flex flex-col"
                onClick={(e) => e.stopPropagation()}
              >
                <button
                  onClick={() => setShowFarmerModal(false)}
                  aria-label="Close"
                  className="absolute top-3 right-3 z-10 h-8 w-8 flex items-center justify-center rounded-full bg-white/20 text-white hover:bg-white/30 transition-colors"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
                    <path d="M18 6L6 18M6 6l12 12" />
                  </svg>
                </button>

                <div className="overflow-y-auto">
                  <div className="h-28 bg-gradient-to-r from-emerald-700 via-emerald-600 to-teal-500" />

                  {farmerDetailLoading && (
                    <div className="px-6 pb-6 -mt-12 animate-pulse">
                      <div className="h-24 w-24 rounded-full bg-slate-200 ring-4 ring-white" />
                      <div className="mt-4 h-5 w-48 rounded bg-slate-200" />
                      <div className="mt-2 h-3 w-64 rounded bg-slate-100" />
                      <div className="mt-6 grid grid-cols-2 gap-4">
                        {Array.from({ length: 6 }).map((_, i) => (
                          <div key={i} className="h-10 rounded bg-slate-100" />
                        ))}
                      </div>
                    </div>
                  )}

                  {farmerDetailError && !farmerDetailLoading && (
                    <div className="p-6">
                      <div className="rounded-lg border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-700">
                        {farmerDetailError}
                      </div>
                    </div>
                  )}

                  {selectedFarmer && !farmerDetailLoading && (() => {
                    const f = selectedFarmer;
                    const fmt = (d?: string) =>
                      d ? new Date(d).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : '-';
                    const fmtTime = (d?: string) =>
                      d
                        ? new Date(d).toLocaleString(undefined, { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
                        : '-';
                    const initials = String(f.name || '?')
                      .split(' ')
                      .filter(Boolean)
                      .map((s: string) => s[0])
                      .slice(0, 2)
                      .join('')
                      .toUpperCase();
                    const statusStyle =
                      f.status === 'active'
                        ? 'bg-emerald-50 text-emerald-700 ring-emerald-200'
                        : f.status === 'pending'
                        ? 'bg-amber-50 text-amber-700 ring-amber-200'
                        : 'bg-slate-100 text-slate-600 ring-slate-200';

                    const sections: { title: string; logo?: string; items: any[][] }[] = [
                      {
                        title: 'Personal information',
                        items: [
                          ['Full name', f.name],
                          ['Gender', f.gender, true],
                          ['Email', f.email],
                          ['Phone', f.phone],
                          ['National ID number', f.id_Number],
                        ],
                      },
                      {
                        title: 'Shop information',
                        logo: f.shopLogo,
                        items: [
                          ['Shop name', f.shopName],
                          ['Category', f.category, true],
                          ['Address', f.shopAddress],
                        ],
                      },
                      {
                        title: 'Account',
                        items: [
                          ['Role', f.role, true],
                          ['Profile type', f.profile, true],
                          ['Verified', f.isVerified ? 'Yes' : 'No'],
                          ['Member since', fmt(f.createdAt)],
                          ['Last updated', fmt(f.updatedAt)],
                          ['Last seen', fmtTime(f.lastSeen)],
                        ],
                      },
                    ];

                    return (
                      <div className="px-6 pb-6">
                        <div className="-mt-12 flex items-end gap-4">
                          <div className="relative h-24 w-24 shrink-0 rounded-full ring-4 ring-white bg-emerald-100 shadow-md overflow-hidden flex items-center justify-center text-2xl font-semibold text-emerald-700">
                            {initials}
                            {f.profile_img && (
                              <img
                                src={f.profile_img}
                                alt={f.name || 'Farmer'}
                                className="absolute inset-0 h-full w-full object-cover"
                                onError={(e) => { e.currentTarget.style.display = 'none'; }}
                              />
                            )}
                          </div>
                          <div className="pb-1 min-w-0">
                            <h2 className="text-lg font-semibold text-slate-900 truncate">{f.name || 'Unnamed'}</h2>
                            <p className="text-xs text-slate-500 truncate">{f.email || '-'}</p>
                          </div>
                        </div>

                        <div className="mt-4 flex flex-wrap gap-2">
                          <span className="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-medium capitalize text-emerald-700 ring-1 ring-inset ring-emerald-200">
                            {f.role || 'user'}
                          </span>
                          <span className={`inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-medium capitalize ring-1 ring-inset ${statusStyle}`}>
                            {f.status || 'unknown'}
                          </span>
                          <span
                            className={`inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-medium ring-1 ring-inset ${
                              f.isVerified
                                ? 'bg-sky-50 text-sky-700 ring-sky-200'
                                : 'bg-slate-100 text-slate-600 ring-slate-200'
                            }`}
                          >
                            {f.isVerified ? 'Verified' : 'Not verified'}
                          </span>
                        </div>

                        <div className="mt-6 space-y-4">
                          {sections.map((section) => (
                            <div key={section.title} className="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
                              <div className="mb-3 flex items-center gap-2">
                                {section.logo && (
                                  <img
                                    src={section.logo}
                                    alt=""
                                    className="h-8 w-8 rounded-lg border border-slate-200 bg-white object-cover"
                                    onError={(e) => { e.currentTarget.style.display = 'none'; }}
                                  />
                                )}
                                <h4 className="text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                                  {section.title}
                                </h4>
                              </div>
                              <dl className="grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
                                {section.items.map(([label, value, cap]) => (
                                  <div key={label} className="min-w-0">
                                    <dt className="text-[10px] font-medium uppercase tracking-wide text-slate-400">{label}</dt>
                                    <dd className={`mt-0.5 text-sm font-medium text-slate-800 break-words ${cap ? 'capitalize' : ''}`}>
                                      {value === undefined || value === null || value === '' ? '-' : String(value)}
                                    </dd>
                                  </div>
                                ))}
                              </dl>
                            </div>
                          ))}

                          {f.id_proof_img && (
                            <div className="rounded-xl border border-slate-100 bg-slate-50/60 p-4">
                              <div className="mb-3 flex items-center justify-between">
                                <h4 className="text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                                  ID document
                                </h4>
                                
                                  <a href={f.id_proof_img}
                                  target="_blank"
                                  rel="noreferrer"
                                  className="text-[11px] font-medium text-emerald-600 hover:text-emerald-700"
                                >
                                  Open full size
                                </a>
                              </div>
                              <a href={f.id_proof_img} target="_blank" rel="noreferrer">
                                <img
                                  src={f.id_proof_img}
                                  alt="ID document"
                                  className="w-full max-h-60 rounded-lg border border-slate-200 bg-white object-contain"
                                  onError={(e) => { e.currentTarget.style.display = 'none'; }}
                                />
                              </a>
                            </div>
                          )}
                        </div>
                      </div>
                    );
                  })()}
                </div>

                <div className="flex justify-end border-t border-slate-100 bg-white px-6 py-3">
                  <button
                    onClick={() => setShowFarmerModal(false)}
                    className="rounded-lg bg-slate-900 px-4 py-2 text-xs font-medium text-white hover:bg-slate-800 transition-colors"
                  >
                    Close
                  </button>
                </div>
              </div>
            </div>
          )}
          {activeView === 'farmers' ? (
            <FarmersView
              farmers={farmers}
              loading={farmersLoading}
              error={farmersError}
              onRetry={fetchFarmers}
              onDelete={deleteFarmer}
              onUpdateRole={updateFarmerRole}
              onView={viewFarmer}
            />
          ) : activeView === 'customers' ? (
            <FarmersView
              farmers={customers}
              loading={customersLoading}
              error={customersError}
              onRetry={fetchCustomers}
              onDelete={deleteCustomer}
              onUpdateRole={updateCustomerRole}
              title="Manage Customers"
              subtitle="All registered customers on the platform"
            />
          ) : activeView === 'animals' ? (
            <div className="space-y-6">
              <div className="flex justify-between items-center">
                <div>
                  <h1 className="text-xl font-bold text-slate-800">All Livestock</h1>
                  <p className="text-xs text-slate-400 mt-0.5">Manage and view all registered animals in the database</p>
                </div>
                <button
                  onClick={fetchAnimals}
                  className="flex items-center gap-1.5 text-xs font-medium text-slate-600 border border-slate-200 bg-white px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors shadow-sm"
                >
                  <RefreshCw size={14} /> Refresh
                </button>
              </div>

              {animalsLoading && (
                <div className="bg-white rounded-xl border border-slate-100 p-12 text-center text-sm text-slate-400">Loading animals...</div>
              )}

              {!animalsLoading && animalsError && (
                <div className="bg-white rounded-xl border border-slate-100 p-12 text-center text-sm text-red-500">{animalsError}</div>
              )}

              {!animalsLoading && !animalsError && animals.length === 0 && (
                <div className="bg-white rounded-xl border border-slate-100 p-12 text-center text-sm text-slate-400">No livestock found in the database.</div>
              )}

              {!animalsLoading && !animalsError && animals.length > 0 && (
                <div className="bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
                  <table className="w-full text-sm">
                    <thead>
                      <tr className="bg-slate-50 border-b border-slate-100">
                        <th className="px-5 py-3 text-left text-xs font-semibold text-slate-500">Image</th>
                        <th className="px-5 py-3 text-left text-xs font-semibold text-slate-500">Name</th>
                        <th className="px-5 py-3 text-left text-xs font-semibold text-slate-500">Species</th>
                        <th className="px-5 py-3 text-left text-xs font-semibold text-slate-500">Breed</th>
                        <th className="px-5 py-3 text-left text-xs font-semibold text-slate-500">Owner</th>
                        <th className="px-5 py-3 text-left text-xs font-semibold text-slate-500">Status</th>
                        <th className="px-5 py-3 text-right text-xs font-semibold text-slate-500">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      {animals.map((animal: any) => (
                        <tr key={animal._id} className="border-b border-slate-50 last:border-0 hover:bg-slate-50/50">
                          <td className="px-5 py-3.5">
                            {animal.images && animal.images.length > 0 ? (
                              <img
                                src={animal.images[0]}
                                alt={animal.name || 'animal'}
                                className="w-10 h-10 rounded-lg object-cover border border-slate-100"
                              />
                            ) : (
                              <div className="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-300 text-[10px]">
                                N/A
                              </div>
                            )}
                          </td>
                          <td className="px-5 py-3.5 text-slate-700 font-medium text-xs">{animal.name || '-'}</td>
                          <td className="px-5 py-3.5 text-slate-500 text-xs capitalize">{animal.type || '-'}</td>
                          <td className="px-5 py-3.5 text-slate-500 text-xs">{animal.breed || '-'}</td>
                          <td className="px-5 py-3.5 text-slate-500 text-xs">
                            {typeof animal.owner === 'string' ? `${animal.owner.slice(0, 8)}...` : (animal.owner?.name || '-')}
                          </td>
                          <td className="px-5 py-3.5">
                            <Badge variant={animal.isAvailable ? 'success' : 'warning'}>
                              {animal.isAvailable ? 'available' : 'listed'}
                            </Badge>
                          </td>
                          <td className="px-5 py-3.5 text-right">
                            <button className="text-[11px] font-medium bg-emerald-600 text-white px-3 py-1.5 rounded-lg hover:bg-emerald-700 transition-colors shadow-sm">
                              View
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          ) : activeView === 'hotels' ? (
            <HotelsView
              hotels={hotels}
              loading={hotelsLoading}
              error={hotelsError}
              onRetry={fetchHotels}
              onApprove={approveHotel}
              onView={viewHotel}
            />
          ) : (
          <>
          {/* Top Bar */}
          <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
            <div className="flex items-center gap-2">
              <div className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
              <span className="text-xs text-slate-500">
                Platform Status: <span className="text-emerald-600 font-semibold">All systems operational</span>
              </span>
            </div>
            <div className="flex items-center gap-2">
              <div className="flex bg-white border border-slate-200 rounded-lg p-0.5">
                <button className="px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-slate-700 rounded-md transition-colors">Today</button>
                <button className="px-3 py-1.5 text-xs font-medium text-white bg-emerald-600 rounded-md transition-colors">Week</button>
                <button className="px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-slate-700 rounded-md transition-colors">Month</button>
              </div>
              <button className="p-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors shadow-sm">
                <Plus size={16} />
              </button>
            </div>
          </div>

          {/* Stats Row */}
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5 mb-6">
            <StatCard
              title="Total Users"
              value="0"
              change="+5.02%"
              isPositive={true}
              icon={Users}
              subtitle="vs last month"
            />
            <StatCard
              title="Total Livestock"
              value="0"
              change="+2.08%"
              isPositive={true}
              icon={Beef}
              subtitle="vs last month"
            />
            <StatCard
              title="Pending Verifications"
              value="142"
              change="-12.0%"
              isPositive={false}
              icon={ShieldCheck}
              subtitle="vs last month"
            />
            <StatCard
              title="Total Transactions"
              value="$2M"
              change="+18.56%"
              isPositive={true}
              icon={DollarSign}
              subtitle="vs last month"
            />
          </div>

          {/* Middle Row */}
          <div className="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-5 mb-6">

            {/* Farmer Registrations */}
            <ChartCard
              title="Farmer Registrations"
              subtitle="Last 9 months"
              action={
                <button className="text-[10px] font-medium text-slate-500 border border-slate-200 px-2.5 py-1 rounded-md hover:bg-slate-50 transition-colors">
                  Details
                </button>
              }
            >
              <div className="h-28 w-full mb-3">
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={farmerRegData}>
                    <Bar dataKey="value" fill="#10b981" radius={[3, 3, 0, 0]} barSize={10} />
                  </BarChart>
                </ResponsiveContainer>
              </div>
              <div className="flex justify-between items-end pt-3 border-t border-slate-50">
                <div>
                  <p className="text-xl font-bold text-slate-800">3,254</p>
                  <p className="text-[10px] text-slate-400">
                    Last Month <span className="text-emerald-600 font-semibold">+5.02%</span>
                  </p>
                </div>
                <div className="p-1.5 rounded-lg bg-emerald-50">
                  <TrendingUp size={14} className="text-emerald-600" />
                </div>
              </div>
            </ChartCard>

            {/* Animal Listings */}
            <ChartCard
              title="Animal Listings"
              subtitle="Last 9 months"
              action={
                <button className="text-[10px] font-medium text-slate-500 border border-slate-200 px-2.5 py-1 rounded-md hover:bg-slate-50 transition-colors">
                  View Report
                </button>
              }
            >
              <div className="h-28 w-full mb-3">
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={animalListingData}>
                    <Bar dataKey="value" fill="#10b981" radius={[3, 3, 0, 0]} barSize={10} />
                  </BarChart>
                </ResponsiveContainer>
              </div>
              <div className="flex justify-between items-end pt-3 border-t border-slate-50">
                <div>
                  <p className="text-xl font-bold text-slate-800">8,543</p>
                  <p className="text-[10px] text-slate-400">
                    Last Month <span className="text-red-500 font-semibold">-1.08%</span>
                  </p>
                </div>
                <div className="p-1.5 rounded-lg bg-red-50">
                  <TrendingDown size={14} className="text-red-500" />
                </div>
              </div>
            </ChartCard>

            {/* Platform Activity */}
            <div className="lg:col-span-2">
              <ChartCard title="Platform Activity" subtitle="Users vs Animals (12 months)">
                <div className="h-44 w-full">
                  <ResponsiveContainer width="100%" height="100%">
                    <BarChart data={platformActivityData} barGap={2}>
                      <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f1f5f9" />
                      <XAxis
                        dataKey="name"
                        tick={{ fontSize: 10, fill: '#94a3b8' }}
                        axisLine={false}
                        tickLine={false}
                        interval={1}
                      />
                      <YAxis
                        tick={{ fontSize: 10, fill: '#94a3b8' }}
                        axisLine={false}
                        tickLine={false}
                      />
                      <Tooltip
                        cursor={{ fill: '#f8fafc' }}
                        contentStyle={{
                          backgroundColor: '#fff',
                          borderColor: '#e2e8f0',
                          borderRadius: '8px',
                          fontSize: '12px',
                          boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1)'
                        }}
                      />
                      <Bar dataKey="users" fill="#10b981" radius={[3, 3, 0, 0]} barSize={8} />
                      <Bar dataKey="animals" fill="#059669" radius={[3, 3, 0, 0]} barSize={8} />
                    </BarChart>
                  </ResponsiveContainer>
                </div>
                <div className="flex items-center gap-4 mt-3 pt-3 border-t border-slate-50">
                  <div className="flex items-center gap-2">
                    <span className="w-2.5 h-2.5 rounded-sm bg-emerald-500"></span>
                    <span className="text-[11px] text-slate-500">Users</span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className="w-2.5 h-2.5 rounded-sm bg-emerald-600"></span>
                    <span className="text-[11px] text-slate-500">Animals</span>
                  </div>
                </div>
              </ChartCard>
            </div>
          </div>

          {/* Transaction Volume & Region */}
          <div className="grid grid-cols-1 xl:grid-cols-3 gap-4 lg:gap-5 mb-6">
            {/* Transaction Volume Chart */}
            <div className="xl:col-span-2">
              <ChartCard
                title="Transaction Volume"
                subtitle="Marketplace vs Escrow"
                action={
                  <div className="flex gap-4 text-[10px]">
                    <div className="flex items-center gap-1.5">
                      <span className="w-2 h-2 rounded-full bg-emerald-500"></span>
                      <span className="text-slate-500">Marketplace <span className="text-slate-700 font-semibold">$58,254</span></span>
                    </div>
                    <div className="flex items-center gap-1.5">
                      <span className="w-2 h-2 rounded-full bg-emerald-600"></span>
                      <span className="text-slate-500">Escrow <span className="text-slate-700 font-semibold">$29,524</span></span>
                    </div>
                  </div>
                }
              >
                <div className="h-56 w-full">
                  <ResponsiveContainer width="100%" height="100%">
                    <AreaChart data={transactionVolumeData}>
                      <defs>
                        <linearGradient id="colorVolume" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="5%" stopColor="#10b981" stopOpacity={0.15}/>
                          <stop offset="95%" stopColor="#10b981" stopOpacity={0}/>
                        </linearGradient>
                        <linearGradient id="colorEscrow" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="5%" stopColor="#059669" stopOpacity={0.15}/>
                          <stop offset="95%" stopColor="#059669" stopOpacity={0}/>
                        </linearGradient>
                      </defs>
                      <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f1f5f9" />
                      <XAxis
                        dataKey="name"
                        axisLine={false}
                        tickLine={false}
                        tick={{ fontSize: 10, fill: '#94a3b8' }}
                        dy={10}
                      />
                      <YAxis
                        axisLine={false}
                        tickLine={false}
                        tick={{ fontSize: 10, fill: '#94a3b8' }}
                      />
                      <Tooltip
                        contentStyle={{
                          backgroundColor: '#fff',
                          borderColor: '#e2e8f0',
                          borderRadius: '8px',
                          fontSize: '12px',
                          boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1)'
                        }}
                      />
                      <Area
                        type="monotone"
                        dataKey="volume"
                        stroke="#10b981"
                        strokeWidth={2.5}
                        fillOpacity={1}
                        fill="url(#colorVolume)"
                      />
                      <Area
                        type="monotone"
                        dataKey="escrow"
                        stroke="#059669"
                        strokeWidth={2.5}
                        fillOpacity={1}
                        fill="url(#colorEscrow)"
                      />
                    </AreaChart>
                  </ResponsiveContainer>
                </div>
              </ChartCard>
            </div>

            {/* Livestock by Region */}
            <ChartCard title="Livestock by Region" subtitle="Distribution across regions">
              {/* Map Placeholder */}
              <div className="w-full h-28 bg-slate-50 rounded-lg mb-4 relative overflow-hidden flex items-center justify-center border border-slate-100">
                <div
                  className="absolute inset-0 opacity-30"
                  style={{
                    backgroundImage: 'radial-gradient(#10b981 1px, transparent 1px)',
                    backgroundSize: '12px 12px'
                  }}
                ></div>
                <span className="text-slate-400 text-[11px] z-10 font-medium">Regional Heatmap</span>
                <div className="absolute top-1/4 left-1/4 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-white shadow-sm"></div>
                <div className="absolute top-1/3 right-1/4 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-white shadow-sm"></div>
                <div className="absolute bottom-1/3 right-1/3 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-white shadow-sm"></div>
              </div>

              <div className="space-y-3.5">
                {[
                  { label: 'Northern Region', value: '2,450', width: '72%' },
                  { label: 'Southern Region', value: '1,890', width: '39%' },
                  { label: 'Eastern Region', value: '1,250', width: '25%' },
                  { label: 'Western Region', value: '2,953', width: '61%' },
                ].map((region, i) => (
                  <div key={i}>
                    <div className="flex justify-between text-[11px] mb-1.5">
                      <span className="text-slate-500 font-medium">{region.label}</span>
                      <span className="text-slate-700 font-bold">{region.value}</span>
                    </div>
                    <div className="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                      <div
                        className="bg-emerald-500 h-full rounded-full transition-all duration-500"
                        style={{ width: region.width }}
                      ></div>
                    </div>
                  </div>
                ))}
              </div>
            </ChartCard>
          </div>

          {/* Bottom Row */}
          <div className="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-5">

            {/* Pending Verifications Table */}
            <div className="lg:col-span-2 bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
              <div className="px-5 py-4 border-b border-slate-50 flex justify-between items-center">
                <div>
                  <h3 className="text-sm font-semibold text-slate-800">Pending Verifications</h3>
                  <p className="text-[11px] text-slate-400 mt-0.5">Items awaiting review</p>
                </div>
                <button className="flex items-center gap-1.5 text-[11px] font-medium text-slate-500 border border-slate-200 px-2.5 py-1.5 rounded-lg hover:bg-slate-50 transition-colors">
                  <Filter size={12} /> Filter
                </button>
              </div>
              <div className="overflow-x-auto">
                <table className="w-full text-left text-sm whitespace-nowrap">
                  <thead className="bg-slate-50 text-slate-500 text-[10px] uppercase font-semibold">
                    <tr>
                      <th className="px-5 py-3">Entity Name</th>
                      <th className="px-5 py-3">Type</th>
                      <th className="px-5 py-3">Time</th>
                      <th className="px-5 py-3 text-right">Action</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-50">
                    {pendingVerifications.map((item) => (
                      <tr key={item.id} className="hover:bg-slate-50/50 transition-colors">
                        <td className="px-5 py-3.5">
                          <div className="flex items-center gap-3">
                            <div className="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-600 shrink-0">
                              <item.icon size={16} />
                            </div>
                            <div>
                              <div className="font-medium text-slate-700 text-xs">{item.name}</div>
                              <div className="text-[10px] text-slate-400">ID: #00{item.id}</div>
                            </div>
                          </div>
                        </td>
                        <td className="px-5 py-3.5">
                          <Badge>{item.type}</Badge>
                        </td>
                        <td className="px-5 py-3.5 text-slate-500 text-xs">{item.date}</td>
                        <td className="px-5 py-3.5 text-right">
                          <button className="text-[11px] font-medium bg-emerald-600 text-white px-3 py-1.5 rounded-lg hover:bg-emerald-700 transition-colors shadow-sm">
                            Review
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            {/* Platform Breakdown */}
            <ChartCard title="Platform Breakdown" subtitle="User distribution">
              <div className="h-36 w-full relative mb-4">
                <ResponsiveContainer width="100%" height="100%">
                  <PieChart>
                    <Pie
                      data={platformBreakdownData}
                      innerRadius={45}
                      outerRadius={65}
                      paddingAngle={4}
                      dataKey="value"
                      stroke="none"
                    >
                      {platformBreakdownData.map((entry, index) => (
                        <Cell key={`cell-${index}`} fill={entry.color} />
                      ))}
                    </Pie>
                  </PieChart>
                </ResponsiveContainer>
                <div className="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                  <span className="text-[10px] text-slate-400 uppercase font-semibold">Total</span>
                  <span className="text-lg font-bold text-slate-800">12,854</span>
                </div>
              </div>
              <div className="grid grid-cols-2 gap-2.5">
                {platformBreakdownData.map((item, i) => (
                  <div key={i} className="flex items-center gap-2">
                    <span className="w-2.5 h-2.5 rounded-full shrink-0" style={{ backgroundColor: item.color }}></span>
                    <span className="text-[11px] text-slate-500 truncate">{item.name}</span>
                    <span className="text-[11px] text-slate-700 font-semibold ml-auto">{item.value}</span>
                  </div>
                ))}
              </div>
            </ChartCard>

            {/* Recent Alerts */}
            <ChartCard title="Recent Alerts" subtitle="Latest notifications">
              <div className="space-y-4">
                {[
                  {
                    icon: AlertTriangle,
                    iconBg: 'bg-red-50',
                    iconColor: 'text-red-500',
                    title: 'Ownership Dispute',
                    desc: 'Farmer John vs Buyer Mike over Cow #C-405',
                    time: '10:00 AM'
                  },
                  {
                    icon: AlertCircle,
                    iconBg: 'bg-amber-50',
                    iconColor: 'text-amber-500',
                    title: 'Payment Failed',
                    desc: 'Transaction #TRX-9821 for Angus Bull',
                    time: '09:30 AM'
                  },
                  {
                    icon: ShieldCheck,
                    iconBg: 'bg-emerald-50',
                    iconColor: 'text-emerald-600',
                    title: 'Verification Approved',
                    desc: 'Vet Dr. Sarah Smith account verified',
                    time: '09:15 AM'
                  },
                ].map((alert, i) => (
                  <div key={i} className="flex items-start gap-3">
                    <div className={`w-8 h-8 rounded-lg ${alert.iconBg} flex items-center justify-center shrink-0`}>
                      <alert.icon size={14} className={alert.iconColor} />
                    </div>
                    <div className="min-w-0">
                      <p className="text-[11px] text-slate-600 leading-snug">
                        <span className="font-semibold text-slate-800">{alert.title}</span>
                        {' � '}{alert.desc}
                      </p>
                      <span className="text-[10px] text-slate-400 mt-1 block flex items-center gap-1">
                        <Clock size={10} />
                        {alert.time}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
              <button className="w-full mt-4 pt-3 border-t border-slate-50 text-[11px] font-medium text-emerald-600 hover:text-emerald-700 transition-colors flex items-center justify-center gap-1">
                View All Alerts <ChevronRight size={12} />
              </button>
            </ChartCard>

          </div>

          <div className="h-6"></div>
          </>
          )}
        </div>
      </main>

      {showHotelModal && (
        <HotelDetailModal
          hotel={selectedHotel}
          loading={hotelDetailLoading}
          error={hotelDetailError}
          onClose={() => setShowHotelModal(false)}
        />
      )}
    </div>
  );
};

export default AdminDashboard;


