// --- Sub Components ---

const SidebarItem = ({ 
  icon: Icon, 
  label, 
  active = false, 
  badge, 
  hasSubmenu = false,
  collapsed = false 
}: { 
  icon: any; 
  label: string; 
  active?: boolean; 
  badge?: string; 
  hasSubmenu?: boolean;
  collapsed?: boolean;
}) => (
  <div className={`group flex items-center justify-between px-3 py-2.5 mx-2 rounded-lg cursor-pointer transition-all duration-200 ${
    active 
      ? 'bg-white/15 text-white shadow-sm' 
      : 'text-emerald-50/80 hover:text-white hover:bg-white/10'
  }`}>
    <div className="flex items-center gap-3 min-w-0">
      <Icon size={18} className="shrink-0" />
      {!collapsed && <span className="text-[13px] font-medium truncate">{label}</span>}
    </div>
    {!collapsed && (
      <div className="flex items-center gap-1.5 shrink-0">
        {badge && (
          <span className="bg-white/20 text-white text-[10px] px-2 py-0.5 rounded-full font-semibold">
            {badge}
          </span>
        )}
        {hasSubmenu && <ChevronRight size={14} className="opacity-60 group-hover:opacity-100 transition-opacity" />}
      </div>
    )}
  </div>
);

const SidebarSection = ({ title, collapsed }: { title: string; collapsed?: boolean }) => (
  <div className={`px-5 mt-6 mb-2 ${collapsed ? 'text-center' : ''}`}>
    {!collapsed && (
      <span className="text-[10px] font-semibold text-emerald-200/60 uppercase tracking-wider">
        {title}
      </span>
    )}
    {collapsed && <div className="h-px bg-white/10 mx-2" />}
  </div>
);

const StatCard = ({ 
  title, 
  value, 
  change, 
  isPositive, 
  icon: Icon,
  subtitle 
}: { 
  title: string; 
  value: string; 
  change: string; 
  isPositive: boolean; 
  icon: any;
  subtitle?: string;
}) => (
  <div className="group bg-white rounded-xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
    <div className="flex justify-between items-start mb-4">
      <div className="p-2.5 rounded-lg bg-emerald-50 text-emerald-600 group-hover:bg-emerald-100 transition-colors">
        <Icon size={20} />
      </div>
      <div className={`flex items-center gap-1 text-xs font-semibold px-2 py-1 rounded-full ${
        isPositive ? 'text-emerald-700 bg-emerald-50' : 'text-red-600 bg-red-50'
      }`}>
        {isPositive ? <ArrowUpRight size={14} /> : <ArrowDownRight size={14} />}
        {change}
      </div>
    </div>
    <div>
      <p className="text-slate-500 text-xs font-medium mb-1">{title}</p>
      <h3 className="text-2xl font-bold text-slate-800 mb-1">{value}</h3>
      {subtitle && <p className="text-[11px] text-slate-400">{subtitle}</p>}
    </div>
  </div>
);

const ChartCard = ({ title, children, action, subtitle }: { title: string; children: React.ReactNode; action?: React.ReactNode; subtitle?: string }) => (
  <div className="bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
    <div className="flex justify-between items-center px-5 py-4 border-b border-slate-50">
      <div>
        <h3 className="text-sm font-semibold text-slate-800">{title}</h3>
        {subtitle && <p className="text-[11px] text-slate-400 mt-0.5">{subtitle}</p>}
      </div>
      {action}
    </div>
    <div className="p-5">{children}</div>
  </div>
);

const Badge = ({ children, variant = 'default' }: { children: React.ReactNode; variant?: 'default' | 'success' | 'warning' | 'danger' }) => {
  const variants = {
    default: 'bg-slate-100 text-slate-600',
    success: 'bg-emerald-50 text-emerald-700',
    warning: 'bg-amber-50 text-amber-700',
    danger: 'bg-red-50 text-red-600',
  };
  return (
    <span className={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${variants[variant]}`}>
      {children}
    </span>
  );
};

// --- Main Layout ---

const AdminDashboard = () => {
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
  const [mobileSidebarOpen, setMobileSidebarOpen] = useState(false);

  return (
    <div className="flex h-screen bg-slate-50 font-sans text-slate-800 overflow-hidden">
      
      {/* Mobile Sidebar Overlay */}
      {mobileSidebarOpen && (
        <div 
          className="fixed inset-0 bg-black/40 z-40 lg:hidden"
          onClick={() => setMobileSidebarOpen(false)}
        />
      )}

      {/* Sidebar */}
      <aside className={`
        fixed lg:static inset-y-0 left-0 z-50
        ${sidebarCollapsed ? 'w-[72px]' : 'w-64'} 
        bg-emerald-600 flex flex-col flex-shrink-0 
        transition-all duration-300 ease-in-out
        ${mobileSidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'}
      `}>
        {/* Logo */}
        <div className={`h-16 flex items-center border-b border-white/10 ${sidebarCollapsed ? 'justify-center px-2' : 'px-5'}`}>
          <div className="flex items-center gap-2.5">
            <div className="w-9 h-9 rounded-lg bg-white/20 flex items-center justify-center text-white font-bold text-lg shrink-0">
              A
            </div>
            {!sidebarCollapsed && (
              <span className="text-white font-bold text-lg tracking-tight">AniMarket</span>
            )}
          </div>
        </div>
        
        {/* Sidebar Content */}
        <div className="flex-1 overflow-y-auto py-4 custom-scrollbar">
          <SidebarSection title="Main" collapsed={sidebarCollapsed} />
          <SidebarItem icon={LayoutDashboard} label="Dashboard" active collapsed={sidebarCollapsed} />
          
          <SidebarSection title="User Management" collapsed={sidebarCollapsed} />
          <SidebarItem icon={Users} label="Manage Farmers" hasSubmenu collapsed={sidebarCollapsed} />
          <SidebarItem icon={Users} label="Manage Customers" hasSubmenu collapsed={sidebarCollapsed} />
          <SidebarItem icon={Building2} label="Manage Hotels" hasSubmenu collapsed={sidebarCollapsed} />
          <SidebarItem icon={Stethoscope} label="Manage Vets" hasSubmenu collapsed={sidebarCollapsed} />
          <SidebarItem icon={ShieldCheck} label="Roles & Permissions" collapsed={sidebarCollapsed} />
          
          <SidebarSection title="Livestock" collapsed={sidebarCollapsed} />
          <SidebarItem icon={Beef} label="All Livestock" hasSubmenu collapsed={sidebarCollapsed} />
          <SidebarItem icon={QrCode} label="Animal Passports" hasSubmenu collapsed={sidebarCollapsed} />
          <SidebarItem icon={FileText} label="Ownership Docs" badge="12" collapsed={sidebarCollapsed} />
          <SidebarItem icon={CheckCircle2} label="Pending Verifications" badge="8" collapsed={sidebarCollapsed} />
          
          <SidebarSection title="Transactions" collapsed={sidebarCollapsed} />
          <SidebarItem icon={DollarSign} label="All Transactions" collapsed={sidebarCollapsed} />
          <SidebarItem icon={Handshake} label="Agreements" collapsed={sidebarCollapsed} />
          <SidebarItem icon={AlertTriangle} label="Disputes" badge="3" collapsed={sidebarCollapsed} />
          
          <SidebarSection title="System" collapsed={sidebarCollapsed} />
          <SidebarItem icon={Stethoscope} label="Veterinary Records" collapsed={sidebarCollapsed} />
          <SidebarItem icon={MessageSquare} label="Communication" collapsed={sidebarCollapsed} />
          <SidebarItem icon={BarChart3} label="Reports & Analytics" collapsed={sidebarCollapsed} />
          <SidebarItem icon={Lock} label="Security & Logs" collapsed={sidebarCollapsed} />
          <SidebarItem icon={SlidersHorizontal} label="Platform Settings" collapsed={sidebarCollapsed} />
        </div>

        {/* Collapse Toggle (Desktop) */}
        <div className="hidden lg:flex items-center justify-center p-3 border-t border-white/10">
          <button 
            onClick={() => setSidebarCollapsed(!sidebarCollapsed)}
            className="w-full flex items-center justify-center gap-2 py-2 rounded-lg text-emerald-50/70 hover:text-white hover:bg-white/10 transition-colors text-xs font-medium"
          >
            {sidebarCollapsed ? <ChevronRight size={16} /> : <ChevronLeft size={16} />}
            {!sidebarCollapsed && <span>Collapse</span>}
          </button>
        </div>
      </aside>

      {/* Main Content */}
      <main className="flex-1 flex flex-col min-w-0 overflow-hidden">
        
        {/* Header */}
        <header className="h-16 bg-white border-b border-slate-100 flex items-center justify-between px-4 lg:px-6 flex-shrink-0 z-30">
          <div className="flex items-center gap-3">
            <button 
              className="lg:hidden p-2 rounded-lg hover:bg-slate-100 text-slate-500"
              onClick={() => setMobileSidebarOpen(true)}
            >
              <Menu size={20} />
            </button>
            <div>
              <h1 className="text-base font-bold text-slate-800">Admin Overview</h1>
              <p className="text-[11px] text-slate-400 hidden sm:block">Welcome back, here's what's happening</p>
            </div>
          </div>
          
          <div className="flex items-center gap-3 lg:gap-4">
            {/* Search */}
            <div className="relative hidden md:block">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" size={16} />
              <input 
                type="text" 
                placeholder="Search..." 
                className="pl-9 pr-4 py-2 bg-slate-50 rounded-lg text-sm border border-slate-200 focus:border-emerald-500 focus:bg-white focus:ring-2 focus:ring-emerald-500/20 outline-none w-56 lg:w-72 text-slate-700 placeholder-slate-400 transition-all"
              />
            </div>
            
            {/* Actions */}
            <div className="flex items-center gap-1.5 lg:gap-2">
              <button className="p-2 rounded-lg hover:bg-slate-100 text-slate-500 transition-colors relative">
                <Bell size={18} />
                <span className="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full ring-2 ring-white"></span>
              </button>
              <button className="p-2 rounded-lg hover:bg-slate-100 text-slate-500 transition-colors hidden sm:block">
                <Moon size={18} />
              </button>
              <button className="p-2 rounded-lg hover:bg-slate-100 text-slate-500 transition-colors hidden sm:block">
                <Settings size={18} />
              </button>
              
              {/* Divider */}
              <div className="w-px h-8 bg-slate-200 mx-1 hidden sm:block" />
              
              {/* Profile */}
              <button className="flex items-center gap-2.5 pl-1 pr-2 py-1 rounded-lg hover:bg-slate-100 transition-colors">
                <div className="w-8 h-8 rounded-lg bg-emerald-600 flex items-center justify-center text-white text-xs font-bold">
                  AD
                </div>
                <div className="hidden lg:block text-left">
                  <p className="text-xs font-semibold text-slate-700 leading-none">Admin User</p>
                  <p className="text-[10px] text-slate-400 mt-0.5">Super Admin</p>
                </div>
                <ChevronDown size={14} className="text-slate-400 hidden lg:block" />
              </button>
            </div>
          </div>
        </header>

        {/* Dashboard Content */}
        <div className="flex-1 overflow-y-auto p-4 lg:p-6 bg-slate-50">
          
          {/* Top Bar */}
          <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
            <div className="flex items-center gap-2">
              <div className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
              <span className="text-xs text-slate-500">
                Platform Status: <span className="text-emerald-600 font-semibold">All systems operational</span>
              </span>
            </div>
            <div className="flex items-center gap-2">
              <div className="flex bg-white border border-slate-200 rounded-lg p-0.5">
                <button className="px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-slate-700 rounded-md transition-colors">Today</button>
                <button className="px-3 py-1.5 text-xs font-medium text-white bg-emerald-600 rounded-md transition-colors">Week</button>
                <button className="px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-slate-700 rounded-md transition-colors">Month</button>
              </div>
              <button className="p-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors shadow-sm">
                <Plus size={16} />
              </button>
            </div>
          </div>

          {/* Stats Row */}
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5 mb-6">
            <StatCard 
              title="Total Users" 
              value="12,854" 
              change="+5.02%" 
              isPositive={true} 
              icon={Users}
              subtitle="vs last month"
            />
            <StatCard 
              title="Total Livestock" 
              value="8,543" 
              change="+2.08%" 
              isPositive={true} 
              icon={Beef}
              subtitle="vs last month"
            />
            <StatCard 
              title="Pending Verifications" 
              value="142" 
              change="-12.0%" 
              isPositive={false} 
              icon={ShieldCheck}
              subtitle="vs last month"
            />
            <StatCard 
              title="Total Transactions" 
              value="$2.4M" 
              change="+18.56%" 
              isPositive={true} 
              icon={DollarSign}
              subtitle="vs last month"
            />
          </div>

          {/* Middle Row */}
          <div className="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-5 mb-6">
            
            {/* Farmer Registrations */}
            <ChartCard 
              title="Farmer Registrations" 
              subtitle="Last 9 months"
              action={
                <button className="text-[10px] font-medium text-slate-500 border border-slate-200 px-2.5 py-1 rounded-md hover:bg-slate-50 transition-colors">
                  Details
                </button>
              }
            >
              <div className="h-28 w-full mb-3">
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={farmerRegData}>
                    <Bar dataKey="value" fill="#10b981" radius={[3, 3, 0, 0]} barSize={10} />
                  </BarChart>
                </ResponsiveContainer>
              </div>
              <div className="flex justify-between items-end pt-3 border-t border-slate-50">
                <div>
                  <p className="text-xl font-bold text-slate-800">3,254</p>
                  <p className="text-[10px] text-slate-400">
                    Last Month <span className="text-emerald-600 font-semibold">+5.02%</span>
                  </p>
                </div>
                <div className="p-1.5 rounded-lg bg-emerald-50">
                  <TrendingUp size={14} className="text-emerald-600" />
                </div>
              </div>
            </ChartCard>

            {/* Animal Listings */}
            <ChartCard 
              title="Animal Listings" 
              subtitle="Last 9 months"
              action={
                <button className="text-[10px] font-medium text-slate-500 border border-slate-200 px-2.5 py-1 rounded-md hover:bg-slate-50 transition-colors">
                  View Report
                </button>
              }
            >
              <div className="h-28 w-full mb-3">
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={animalListingData}>
                    <Bar dataKey="value" fill="#10b981" radius={[3, 3, 0, 0]} barSize={10} />
                  </BarChart>
                </ResponsiveContainer>
              </div>
              <div className="flex justify-between items-end pt-3 border-t border-slate-50">
                <div>
                  <p className="text-xl font-bold text-slate-800">8,543</p>
                  <p className="text-[10px] text-slate-400">
                    Last Month <span className="text-red-500 font-semibold">-1.08%</span>
                  </p>
                </div>
                <div className="p-1.5 rounded-lg bg-red-50">
                  <TrendingDown size={14} className="text-red-500" />
                </div>
              </div>
            </ChartCard>

            {/* Platform Activity */}
            <div className="lg:col-span-2">
              <ChartCard title="Platform Activity" subtitle="Users vs Animals (12 months)">
                <div className="h-44 w-full">
                  <ResponsiveContainer width="100%" height="100%">
                    <BarChart data={platformActivityData} barGap={2}>
                      <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f1f5f9" />
                      <XAxis 
                        dataKey="name" 
                        tick={{ fontSize: 10, fill: '#94a3b8' }} 
                        axisLine={false} 
                        tickLine={false}
                        interval={1}
                      />
                      <YAxis 
                        tick={{ fontSize: 10, fill: '#94a3b8' }} 
                        axisLine={false} 
                        tickLine={false} 
                      />
                      <Tooltip 
                        cursor={{ fill: '#f8fafc' }} 
                        contentStyle={{ 
                          backgroundColor: '#fff', 
                          borderColor: '#e2e8f0', 
                          borderRadius: '8px',
                          fontSize: '12px',
                          boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1)'
                        }} 
                      />
                      <Bar dataKey="users" fill="#10b981" radius={[3, 3, 0, 0]} barSize={8} />
                      <Bar dataKey="animals" fill="#059669" radius={[3, 3, 0, 0]} barSize={8} />
                    </BarChart>
                  </ResponsiveContainer>
                </div>
                <div className="flex items-center gap-4 mt-3 pt-3 border-t border-slate-50">
                  <div className="flex items-center gap-2">
                    <span className="w-2.5 h-2.5 rounded-sm bg-emerald-500"></span>
                    <span className="text-[11px] text-slate-500">Users</span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className="w-2.5 h-2.5 rounded-sm bg-emerald-600"></span>
                    <span className="text-[11px] text-slate-500">Animals</span>
                  </div>
                </div>
              </ChartCard>
            </div>
          </div>

          {/* Transaction Volume & Region */}
          <div className="grid grid-cols-1 xl:grid-cols-3 gap-4 lg:gap-5 mb-6">
            {/* Transaction Volume Chart */}
            <div className="xl:col-span-2">
              <ChartCard 
                title="Transaction Volume" 
                subtitle="Marketplace vs Escrow"
                action={
                  <div className="flex gap-4 text-[10px]">
                    <div className="flex items-center gap-1.5">
                      <span className="w-2 h-2 rounded-full bg-emerald-500"></span>
                      <span className="text-slate-500">Marketplace <span className="text-slate-700 font-semibold">$58,254</span></span>
                    </div>
                    <div className="flex items-center gap-1.5">
                      <span className="w-2 h-2 rounded-full bg-emerald-600"></span>
                      <span className="text-slate-500">Escrow <span className="text-slate-700 font-semibold">$29,524</span></span>
                    </div>
                  </div>
                }
              >
                <div className="h-56 w-full">
                  <ResponsiveContainer width="100%" height="100%">
                    <AreaChart data={transactionVolumeData}>
                      <defs>
                        <linearGradient id="colorVolume" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="5%" stopColor="#10b981" stopOpacity={0.15}/>
                          <stop offset="95%" stopColor="#10b981" stopOpacity={0}/>
                        </linearGradient>
                        <linearGradient id="colorEscrow" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="5%" stopColor="#059669" stopOpacity={0.15}/>
                          <stop offset="95%" stopColor="#059669" stopOpacity={0}/>
                        </linearGradient>
                      </defs>
                      <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f1f5f9" />
                      <XAxis 
                        dataKey="name" 
                        axisLine={false} 
                        tickLine={false} 
                        tick={{ fontSize: 10, fill: '#94a3b8' }} 
                        dy={10} 
                      />
                      <YAxis 
                        axisLine={false} 
                        tickLine={false} 
                        tick={{ fontSize: 10, fill: '#94a3b8' }} 
                      />
                      <Tooltip 
                        contentStyle={{ 
                          backgroundColor: '#fff', 
                          borderColor: '#e2e8f0', 
                          borderRadius: '8px',
                          fontSize: '12px',
                          boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1)'
                        }} 
                      />
                      <Area 
                        type="monotone" 
                        dataKey="volume" 
                        stroke="#10b981" 
                        strokeWidth={2.5} 
                        fillOpacity={1} 
                        fill="url(#colorVolume)" 
                      />
                      <Area 
                        type="monotone" 
                        dataKey="escrow" 
                        stroke="#059669" 
                        strokeWidth={2.5} 
                        fillOpacity={1} 
                        fill="url(#colorEscrow)" 
                      />
                    </AreaChart>
                  </ResponsiveContainer>
                </div>
              </ChartCard>
            </div>

            {/* Livestock by Region */}
            <ChartCard title="Livestock by Region" subtitle="Distribution across regions">
              {/* Map Placeholder */}
              <div className="w-full h-28 bg-slate-50 rounded-lg mb-4 relative overflow-hidden flex items-center justify-center border border-slate-100">
                <div 
                  className="absolute inset-0 opacity-30" 
                  style={{ 
                    backgroundImage: 'radial-gradient(#10b981 1px, transparent 1px)', 
                    backgroundSize: '12px 12px' 
                  }}
                ></div>
                <span className="text-slate-400 text-[11px] z-10 font-medium">Regional Heatmap</span>
                <div className="absolute top-1/4 left-1/4 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-white shadow-sm"></div>
                <div className="absolute top-1/3 right-1/4 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-white shadow-sm"></div>
                <div className="absolute bottom-1/3 right-1/3 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-white shadow-sm"></div>
              </div>

              <div className="space-y-3.5">
                {[
                  { label: 'Northern Region', value: '2,450', width: '72%' },
                  { label: 'Southern Region', value: '1,890', width: '39%' },
                  { label: 'Eastern Region', value: '1,250', width: '25%' },
                  { label: 'Western Region', value: '2,953', width: '61%' },
                ].map((region, i) => (
                  <div key={i}>
                    <div className="flex justify-between text-[11px] mb-1.5">
                      <span className="text-slate-500 font-medium">{region.label}</span>
                      <span className="text-slate-700 font-bold">{region.value}</span>
                    </div>
                    <div className="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                      <div 
                        className="bg-emerald-500 h-full rounded-full transition-all duration-500" 
                        style={{ width: region.width }}
                      ></div>
                    </div>
                  </div>
                ))}
              </div>
            </ChartCard>
          </div>

          {/* Bottom Row */}
          <div className="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-5">
            
            {/* Pending Verifications Table */}
            <div className="lg:col-span-2 bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
              <div className="px-5 py-4 border-b border-slate-50 flex justify-between items-center">
                <div>
                  <h3 className="text-sm font-semibold text-slate-800">Pending Verifications</h3>
                  <p className="text-[11px] text-slate-400 mt-0.5">Items awaiting review</p>
                </div>
                <button className="flex items-center gap-1.5 text-[11px] font-medium text-slate-500 border border-slate-200 px-2.5 py-1.5 rounded-lg hover:bg-slate-50 transition-colors">
                  <Filter size={12} /> Filter
                </button>
              </div>
              <div className="overflow-x-auto">
                <table className="w-full text-left text-sm whitespace-nowrap">
                  <thead className="bg-slate-50 text-slate-500 text-[10px] uppercase font-semibold">
                    <tr>
                      <th className="px-5 py-3">Entity Name</th>
                      <th className="px-5 py-3">Type</th>
                      <th className="px-5 py-3">Time</th>
                      <th className="px-5 py-3 text-right">Action</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-50">
                    {pendingVerifications.map((item) => (
                      <tr key={item.id} className="hover:bg-slate-50/50 transition-colors">
                        <td className="px-5 py-3.5">
                          <div className="flex items-center gap-3">
                            <div className="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-600 shrink-0">
                              <item.icon size={16} />
                            </div>
                            <div>
                              <div className="font-medium text-slate-700 text-xs">{item.name}</div>
                              <div className="text-[10px] text-slate-400">ID: #00{item.id}</div>
                            </div>
                          </div>
                        </td>
                        <td className="px-5 py-3.5">
                          <Badge>{item.type}</Badge>
                        </td>
                        <td className="px-5 py-3.5 text-slate-500 text-xs">{item.date}</td>
                        <td className="px-5 py-3.5 text-right">
                          <button className="text-[11px] font-medium bg-emerald-600 text-white px-3 py-1.5 rounded-lg hover:bg-emerald-700 transition-colors shadow-sm">
                            Review
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            {/* Platform Breakdown */}
            <ChartCard title="Platform Breakdown" subtitle="User distribution">
              <div className="h-36 w-full relative mb-4">
                <ResponsiveContainer width="100%" height="100%">
                  <PieChart>
                    <Pie 
                      data={platformBreakdownData} 
                      innerRadius={45} 
                      outerRadius={65} 
                      paddingAngle={4} 
                      dataKey="value"
                      stroke="none"
                    >
                      {platformBreakdownData.map((entry, index) => (
                        <Cell key={`cell-${index}`} fill={entry.color} />
                      ))}
                    </Pie>
                  </PieChart>
                </ResponsiveContainer>
                <div className="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                  <span className="text-[10px] text-slate-400 uppercase font-semibold">Total</span>
                  <span className="text-lg font-bold text-slate-800">12,854</span>
                </div>
              </div>
              <div className="grid grid-cols-2 gap-2.5">
                {platformBreakdownData.map((item, i) => (
                  <div key={i} className="flex items-center gap-2">
                    <span className="w-2.5 h-2.5 rounded-full shrink-0" style={{ backgroundColor: item.color }}></span>
                    <span className="text-[11px] text-slate-500 truncate">{item.name}</span>
                    <span className="text-[11px] text-slate-700 font-semibold ml-auto">{item.value}</span>
                  </div>
                ))}
              </div>
            </ChartCard>

            {/* Recent Alerts */}
            <ChartCard title="Recent Alerts" subtitle="Latest notifications">
              <div className="space-y-4">
                {[
                  { 
                    icon: AlertTriangle, 
                    iconBg: 'bg-red-50', 
                    iconColor: 'text-red-500',
                    title: 'Ownership Dispute',
                    desc: 'Farmer John vs Buyer Mike over Cow #C-405',
                    time: '10:00 AM'
                  },
                  { 
                    icon: AlertCircle, 
                    iconBg: 'bg-amber-50', 
                    iconColor: 'text-amber-500',
                    title: 'Payment Failed',
                    desc: 'Transaction #TRX-9821 for Angus Bull',
                    time: '09:30 AM'
                  },
                  { 
                    icon: ShieldCheck, 
                    iconBg: 'bg-emerald-50', 
                    iconColor: 'text-emerald-600',
                    title: 'Verification Approved',
                    desc: 'Vet Dr. Sarah Smith account verified',
                    time: '09:15 AM'
                  },
                ].map((alert, i) => (
                  <div key={i} className="flex items-start gap-3">
                    <div className={`w-8 h-8 rounded-lg ${alert.iconBg} flex items-center justify-center shrink-0`}>
                      <alert.icon size={14} className={alert.iconColor} />
                    </div>
                    <div className="min-w-0">
                      <p className="text-[11px] text-slate-600 leading-snug">
                        <span className="font-semibold text-slate-800">{alert.title}</span>
                        {' — '}{alert.desc}
                      </p>
                      <span className="text-[10px] text-slate-400 mt-1 block flex items-center gap-1">
                        <Clock size={10} />
                        {alert.time}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
              <button className="w-full mt-4 pt-3 border-t border-slate-50 text-[11px] font-medium text-emerald-600 hover:text-emerald-700 transition-colors flex items-center justify-center gap-1">
                View All Alerts <ChevronRight size={12} />
              </button>
            </ChartCard>

          </div>

          <div className="h-6"></div>
        </div>
      </main>
    </div>
  );
};

export default AdminDashboard;